# =============================================================================
# Kredo Portal Backend — Production Environment
# Copy to .env and replace every <...> value before deploying.
# Keep .env private (chmod 600 .env); never commit it.
# =============================================================================

# ── Server ──
NODE_ENV=production
PORT=5099
HOST=127.0.0.1

# ── MongoDB (Atlas or another production MongoDB; don't use localhost unless mongod is installed) ──
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/kredo-portal?retryWrites=true&w=majority

# ── JWT ──
# Generate with: openssl rand -hex 64
JWT_SECRET=<64-byte-random-secret>
JWT_EXPIRES_IN=7d

# ── Master Admin Account (seeded on first boot) ──
MASTER_EMAIL=<real-admin-email>
MASTER_PASSWORD=<unique-strong-admin-password>

# Optional initial partner account. Leave blank if not needed.
PARTNER_EMAIL=
PARTNER_PASSWORD=

# ── Frontend / CORS ──
# Use the frontend website origin(s), not this backend API hostname.
FRONTEND_URL=https://<your-frontend-domain>
CORS_ORIGINS=https://<your-frontend-domain>

# ── Optional SMTP (required for password reset emails) ──
# SMTP_SECURE is derived from the port (465 uses TLS; 587 uses STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_FROM=
