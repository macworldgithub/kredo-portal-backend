# =============================================================================
# Kredo Portal Backend — Environment Variables
# Copy this to .env and fill in real values for your VPS deployment
# =============================================================================

# ── Server ──
NODE_ENV=production
PORT=5099
HOST=127.0.0.1

# ── MongoDB ──
MONGODB_URI=mongodb://127.0.0.1:27017/kredo-portal

# ── JWT ──
# IMPORTANT: Generate a strong random secret for production!
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── Master Admin Account (seeded on first boot) ──
MASTER_EMAIL=admin@kredo.local
MASTER_PASSWORD=ChangeMe123!

# ── Default Partner Account (seeded on first boot) ──
PARTNER_EMAIL=partner@kredo.local
PARTNER_PASSWORD=ChangeMe123!

# ── Frontend / CORS ──
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── SMTP (for password reset emails) ──
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_FROM=
